{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "BrokerWithWarrantOnly",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::111122223333:user/admin"
            },
            "Action": [
                "sts:AssumeRole",
                "sts:SetSourceIdentity"
            ],
            "Condition": {
                "StringLike": {
                    "sts:SourceIdentity": "rw1-*"
                }
            }
        }
    ]
}
